# ==========================================
# J-RAG Enterprise 环境变量模板
# 使用方法: 复制此文件为 .env 并填入真实 Key
# ==========================================

# --- 数据库配置 (PostgreSQL) ---
# Docker 内部网络地址
DB_URL=jdbc:postgresql://db:5432/jrag?currentSchema=jrag_core,public&characterEncoding=UTF-8
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- LLM 聊天模型 (OpenAI/DeepSeek/Ollama) ---
# 对应 application.properties 中的 ${CHAT_MODEL_BASE_URL} 等
CHAT_MODEL_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_NAME=gpt-4o
# 注意：变量名必须与后端配置中的 ${...} 保持一致
CHAT_API_KEY=sk-xxxx

# --- Embedding 向量模型 ---
EMBEDDING_MODEL_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_MODEL_API_KEY=sk-xxxx

# --- Rerank 重排序模型 (Jina AI) ---
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.jina.ai/v1/rerank
RERANK_MODEL_NAME=jina-reranker-v3
RERANK_API_KEY=jina_xxxx

# --- Vision 视觉模型 (用于 PDF 图表/OCR) ---
VISION_ENABLED=true
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL_NAME=gpt-4-vision-preview
VISION_API_KEY=sk-xxxx

# --- LangFuse 可观测性 (监控 Token 消耗) ---
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx

# --- 安全配置 (JWT) ---
# 必须修改！建议使用 `openssl rand -hex 32` 生成
JWT_SECRET=please_change_this_secret_to_something_very_long_and_random