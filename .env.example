# --- 数据库配置 (PostgreSQL) ---
# Docker Compose 内部使用时，DB_URL 应指向 'db' 服务
# 注意：已启用 Schema 隔离，请保留 currentSchema=jrag_core 参数
DB_URL=jdbc:postgresql://db:5432/jrag?currentSchema=jrag_core
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- LLM 聊天模型配置 ---
CHAT_MODEL_API_KEY=
CHAT_MODEL_BASE_URL=
CHAT_MODEL_NAME=

# --- Embedding 向量模型配置 ---
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_BASE_URL=
EMBEDDING_MODEL_NAME=

# --- Rerank 重排序模型配置 (可选) ---
RERANK_ENABLED=true
RERANK_API_KEY=
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_MODEL_NAME=jina-reranker-v2-base-multilingual

# --- Vision 视觉模型配置 (用于 OCR/图表分析) ---
VISION_ENABLED=true
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=
VISION_MODEL_NAME=

# --- Langfuse 可观测性配置 ---
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- 安全配置 ---
# 建议使用至少 32 位的随机字符串
JWT_SECRET=your_super_secret_jwt_key_here
